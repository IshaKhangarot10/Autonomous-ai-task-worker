# ── LLM ──
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_RPM=5

# ── MongoDB ──
# Two logical databases on the same server; connection string points to the server.
MONGODB_URI=mongodb://localhost:27017

# ── Portal (the mock company app the agent interacts with) ──
PORTAL_PORT=4000
PORTAL_URL=http://localhost:4000
PORTAL_USER=demo
PORTAL_PASS=demo123
PORTAL_SESSION_SECRET=change-me-in-production

# ── Agent server ──
AGENT_PORT=4001

# ── Dashboard ──
DASHBOARD_PORT=3000

# ── Agent behaviour ──
HEADLESS=false
MAX_STEPS=30
MAX_RUN_TIME_MS=300000
AUTO_APPROVE=false

# ── Chaos modes (comma-separated, or "none") ──
# Options: flaky_submit, slow_load, renamed_fields, session_expiry, popup
CHAOS=none
